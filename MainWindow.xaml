<Window x:Class="DFS_Visualizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Визуализатор DFS (Поиск в глубину)" Height="850" Width="1200"
        WindowStartupLocation="CenterScreen" Background="#F0F0F0">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Ввод / генерация -->
        <TextBlock Grid.Row="0" Text="Дерево для обхода (DFS):" Margin="0,0,0,5" FontWeight="SemiBold"/>
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TreeInputBox" Grid.Column="0" Height="25" 
                     VerticalContentAlignment="Center" Padding="5,0" 
                     Text="1,2,3,4,5,6,7" ToolTip="Узлы дерева, заполнение по уровням"/>
            <Button x:Name="GenButton" Grid.Column="1" Content="Сгенерировать" Width="130" Height="25" Margin="10,0,0,0"
                    Click="GenButton_Click"/>
            <Button x:Name="DfsRecButton" Grid.Column="2" Content="DFS (рекурсия)" Width="120" Height="25" Margin="10,0,0,0"
                    Click="DfsRecButton_Click" IsEnabled="False"/>
            <Button x:Name="DfsStackBtn" Grid.Column="3" Content="DFS (стек)" Width="110" Height="25" Margin="10,0,0,0"
                    Click="DfsStackBtn_Click" IsEnabled="False"/>
            <Button x:Name="ClearButton" Grid.Column="4" Content="Сброс" Width="100" Height="25" Margin="10,0,0,0"
                    Click="ClearButton_Click"/>
        </Grid>

        <!-- Скорость и результат -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Скорость:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox x:Name="SpeedComboBox" Width="120" SelectedIndex="1" VerticalAlignment="Center">
                    <ComboBoxItem Content="Медленно"/>
                    <ComboBoxItem Content="Нормально"/>
                    <ComboBoxItem Content="Быстро"/>
                </ComboBox>
                <TextBlock x:Name="StepTextBlock" Text="  Шаг: 0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#444"/>
                <TextBlock Text="   (Ctrl + колесо = зум, тачпад = свайп/щипок)" 
                           VerticalAlignment="Center" FontSize="11" Foreground="#777" Margin="10,0,0,0"/>
            </StackPanel>
            <TextBlock x:Name="StatusTextBlock" Grid.Column="1" Text="Готово к запуску" 
                       FontSize="15" FontWeight="Bold" Foreground="#4A148C" VerticalAlignment="Center"/>
        </Grid>

        <!-- Основная область -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Дерево (с камерой) -->
            <Border Grid.Column="0" BorderBrush="#CCC" BorderThickness="1" Background="White" ClipToBounds="True">
                <Grid>
                    <Canvas x:Name="MainCanvas" Background="Transparent"
                            MouseLeftButtonDown="MainCanvas_MouseLeftButtonDown"
                            MouseMove="MainCanvas_MouseMove"
                            MouseLeftButtonUp="MainCanvas_MouseLeftButtonUp"
                            MouseWheel="MainCanvas_MouseWheel"
                            IsManipulationEnabled="True"
                            ManipulationStarting="MainCanvas_ManipulationStarting"
                            ManipulationDelta="MainCanvas_ManipulationDelta">
                        <Canvas.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="TreeScaleTransform" ScaleX="1" ScaleY="1"/>
                                <TranslateTransform x:Name="TreeTranslateTransform" X="0" Y="0"/>
                            </TransformGroup>
                        </Canvas.RenderTransform>

                        <Canvas x:Name="TreeCanvas" Width="1500" Height="1000"/>
                    </Canvas>
                </Grid>
            </Border>

            <!-- Правая панель -->
            <Border Grid.Column="2" BorderBrush="#CCC" BorderThickness="1" Background="White" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Порядок обхода (посещения):" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock x:Name="VisitedOrderTextBlock" Grid.Row="1" Text="—" 
                               FontSize="13" Foreground="#8B0000" Margin="0,0,0,10" TextWrapping="Wrap"/>

                    <TextBlock Grid.Row="2" Text="Содержимое стека (вершина — сверху):" FontWeight="Bold" Margin="0,0,0,5"/>
                    <Border Grid.Row="3" BorderBrush="#CCC" BorderThickness="1" Background="#FAFAFA" 
                            Padding="8" Margin="0,0,0,10" MinHeight="80">
                        <StackPanel x:Name="StackPanelView"/>
                    </Border>

                    <Grid Grid.Row="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Журнал действий:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="LogPanel"/>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>